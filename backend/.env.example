# Copie este arquivo para .env e preencha os valores reais.
# development (padrão) ou production. Em production, /docs, /redoc e /openapi.json ficam
# desligados e as respostas levam o cabeçalho HSTS. Outro valor impede a API de subir.
# No Render (onde a variável RENDER existe), só production é aceito, e production exige
# TRUST_PROXY_HEADERS=true (veja abaixo).
APP_ENV=development
# postgresql:// ou postgres:// (como o Render entrega) viram postgresql+psycopg:// sozinhos.
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@localhost:5432/estoque_inteligente
# Gere com: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-gerada
ACCESS_TOKEN_EXPIRE_MINUTES=60

TEST_DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/nome_do_banco_test

# RN-50 (opcional): com dois usuários no banco, a DATABASE_URL acima usa o usuário da
# aplicação (sem poder de alterar a estrutura) e as migrations usam o dono.
# Sem MIGRATIONS_DATABASE_URL, o Alembic usa a DATABASE_URL.
# Formato: postgresql+psycopg://DONO:SENHA_DO_DONO@localhost:5432/estoque_inteligente
MIGRATIONS_DATABASE_URL=
# Nome do usuário da aplicação: a migration de permissões concede a ele só o necessário.
# Sem valor, a migration não faz nada.
APP_DB_ROLE=
# Banco _test com o usuário da aplicação, para os testes de permissão (CT-60, CT-61).
# Sem valor, esses testes são pulados.
TEST_APP_DATABASE_URL=

# Teste de ponta a ponta (npm run test:e2e, dentro de frontend): banco cujo nome termina em _e2e,
# recriado a cada execução. A primeira usa o dono (migrations, com a APP_DB_ROLE acima);
# a segunda, o usuário da aplicação (a API da porta 8001). Sem valor, o teste não roda.
E2E_DATABASE_URL=
E2E_APP_DATABASE_URL=

# Opcional: origens do frontend que podem chamar a API, separadas por vírgula.
# Sem valor, vale http://localhost:5173 (Vite em desenvolvimento).
CORS_ORIGINS=http://localhost:5173

# RN-47: true só quando a API estiver atrás de um proxy confiável (Render), para o
# limite de login usar o IP real do X-Forwarded-For. Em desenvolvimento, deixe false.
TRUST_PROXY_HEADERS=false

# Modo de demonstração (RN-53 a RN-55). Com DEMO_MODE=true, a API recria TODO o banco do zero
# pelas migrations ao iniciar, se a última recriação passou de 24 horas; o comando
# py -m app.scripts.reset_demo recria na hora. Só ligue no banco de demonstração!
# Exige MIGRATIONS_DATABASE_URL (usuário dono) definida e as contas abaixo (8 a 128 caracteres
# nas senhas). DEMO_EMAIL e DEMO_PASSWORD são públicas (README e botão do login).
DEMO_MODE=false
DEMO_EMAIL=demo@exemplo.com.br
DEMO_PASSWORD=
# Admin do dono do sistema, recriado junto (nunca no código)
ADMIN_EMAIL=
ADMIN_PASSWORD=
