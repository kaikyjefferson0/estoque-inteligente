# Copie para .env. Endereço da API (sem barra no final).
VITE_API_URL=http://127.0.0.1:8000

# Modo de demonstração (RN-53 a RN-55): com VITE_DEMO=true, o login mostra o botão
# "Entrar como demonstração", que entra com a conta abaixo. Ela é pública (vai no código do
# site e no README) e precisa ser a mesma DEMO_EMAIL/DEMO_PASSWORD da API.
VITE_DEMO=false
VITE_DEMO_EMAIL=demo@exemplo.com.br
VITE_DEMO_SENHA=
