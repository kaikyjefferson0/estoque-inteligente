# Opcional: o docker compose funciona sem este arquivo, com padrões só para uso local.
# Para mudar algo, copie para .env (na raiz) e preencha; variável vazia usa o padrão do
# docker-compose.yml. Este arquivo vale só para o Docker: a API fora dele usa o backend\.env.
# Nunca coloque aqui credenciais do Neon ou do Render.

# Portas no seu computador (só em 127.0.0.1)
API_PORT=
SITE_PORT=

# Banco local. Use só letras, números e hífen nas senhas (elas entram nas URLs de conexão).
# Usuários e senhas só valem na criação do volume: depois de mudar, rode docker compose down -v
# (apaga os dados locais).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
APP_DB_ROLE=
APP_DB_PASSWORD=

# Pelo menos 32 caracteres. Gere com: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Contas criadas ao subir (senhas de 8 a 128 caracteres). A conta de demonstração é o operador do
# botão "Entrar como demonstração" do login; depois de mudá-la, rode docker compose up --build -d.
# As contas só mudam na recriação dos dados: docker compose exec api python -m app.scripts.reset_demo
DEMO_EMAIL=
DEMO_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
